        {
          "number": 436,
          "text": "static void"
        },
        {
          "number": 437,
          "text": "nvme_tcp_ctrlr_disconnect_qpair(struct spdk_nvme_ctrlr *ctrlr, struct spdk_nvme_qpair *qpair)"
        },
        {
          "number": 438,
          "text": "{"
        },
        {
          "number": 439,
          "text": "\tstruct nvme_tcp_qpair *tqpair = nvme_tcp_qpair(qpair);"
        },
        {
          "number": 440,
          "text": "\tstruct nvme_tcp_pdu *pdu;"
        },
        {
          "number": 441,
          "text": "\tint rc;"
        },
        {
          "number": 442,
          "text": "\tstruct nvme_tcp_poll_group *group;"
        },
        {
          "number": 443,
          "text": ""
        },
        {
          "number": 444,
          "text": "\tif (qpair->poll_group) {"
        },
        {
          "number": 445,
          "text": "\t\tgroup = nvme_tcp_poll_group(qpair->poll_group);"
        },
        {
          "number": 446,
          "text": ""
        },
        {
          "number": 447,
          "text": "\t\tif (TAILQ_ENTRY_ENQUEUED(tqpair, link_poll)) {"
        },
        {
          "number": 448,
          "text": "\t\t\tTAILQ_REMOVE_CLEAR(&group->needs_poll, tqpair, link_poll);"
        },
        {
          "number": 449,
          "text": "\t\t}"
        },
        {
          "number": 450,
          "text": ""
        },
        {
          "number": 451,
          "text": "\t\tif (group->sock_group && tqpair->sock) {"
        },
        {
          "number": 452,
          "text": "\t\t\trc = spdk_sock_group_remove_sock(group->sock_group, tqpair->sock);"
        },
        {
          "number": 453,
          "text": "\t\t\tif (rc < 0) {"
        },
        {
          "number": 454,
          "text": "\t\t\t\tSPDK_ERRLOG(\"spdk_sock_group_remove_sock() failed, rc %d: %s\\n\", rc, spdk_strerror(-rc));"
        },
        {
          "number": 455,
          "text": "\t\t\t}"
        },
        {
          "number": 456,
          "text": "\t\t}"
        },
        {
          "number": 457,
          "text": "\t}"
        },
        {
          "number": 458,
          "text": ""
        },
        {
          "number": 459,
          "text": "\trc = spdk_sock_close(&tqpair->sock);"
        },
        {
          "number": 460,
          "text": "\tif (rc < 0 || tqpair->sock) {"
        },
        {
          "number": 461,
          "text": "\t\tNVME_TQPAIR_ERRLOG(tqpair, \"spdk_sock_close() failed, rc %d: %s\\n\", rc, spdk_strerror(-rc));"
        },
        {
          "number": 462,
          "text": "\t\t/* Set it to NULL manually */"
        },
        {
          "number": 463,
          "text": "\t\ttqpair->sock = NULL;"
        },
        {
          "number": 464,
          "text": "\t}"
        },
        {
          "number": 465,
          "text": ""
        },
        {
          "number": 466,
          "text": "\t/* clear the send_queue */"
        },
        {
          "number": 467,
          "text": "\twhile (!TAILQ_EMPTY(&tqpair->send_queue)) {"
        },
        {
          "number": 468,
          "text": "\t\tpdu = TAILQ_FIRST(&tqpair->send_queue);"
        },
        {
          "number": 469,
          "text": "\t\t/* Remove the pdu from the send_queue to prevent the wrong sending out"
        },
        {
          "number": 470,
          "text": "\t\t * in the next round connection"
        },
        {
          "number": 471,
          "text": "\t\t */"
        },
        {
          "number": 472,
          "text": "\t\tTAILQ_REMOVE(&tqpair->send_queue, pdu, tailq);"
        },
        {
          "number": 473,
          "text": "\t}"
        },
        {
          "number": 474,
          "text": ""
        },
        {
          "number": 475,
          "text": "\tnvme_tcp_qpair_abort_reqs(qpair, qpair->abort_dnr);"
        },
        {
          "number": 476,
          "text": ""
        },
        {
          "number": 477,
          "text": "\t/* If the qpair is marked as asynchronous, let it go through the process_completions() to"
        },
        {
          "number": 478,
          "text": "\t * let any outstanding requests (e.g. those with outstanding accel operations) complete."
        },
        {
          "number": 479,
          "text": "\t * Otherwise, there's no way of waiting for them, so tqpair->outstanding_reqs has to be"
        },
        {
          "number": 480,
          "text": "\t * empty."
        },
        {
          "number": 481,
          "text": "\t */"
        },
        {
          "number": 482,
          "text": "\tif (qpair->async) {"
        },
        {
          "number": 483,
          "text": "\t\tnvme_tcp_qpair_set_recv_state(tqpair, NVME_TCP_PDU_RECV_STATE_QUIESCING);"
        },
        {
          "number": 484,
          "text": "\t} else {"
        },
        {
          "number": 485,
          "text": "\t\tassert(TAILQ_EMPTY(&tqpair->outstanding_reqs));"
        },
        {
          "number": 486,
          "text": "\t\tnvme_tcp_ctrlr_disconnect_qpair_done(qpair);"
        },
        {
          "number": 487,
          "text": "\t}"
        },
        {
          "number": 488,
          "text": "}"
        }
      ]
