        {
          "number": 1849,
          "text": "/**"
        },
        {
          "number": 1850,
          "text": " * Allocate an I/O queue pair (submission and completion queue)."
        },
        {
          "number": 1851,
          "text": " *"
        },
        {
          "number": 1852,
          "text": " * This function by default also performs any connection activities required for"
        },
        {
          "number": 1853,
          "text": " * a newly created qpair. To avoid that behavior, the user should set the create_only"
        },
        {
          "number": 1854,
          "text": " * flag in the opts structure to true."
        },
        {
          "number": 1855,
          "text": " *"
        },
        {
          "number": 1856,
          "text": " * Each queue pair should only be used from a single thread at a time (mutual"
        },
        {
          "number": 1857,
          "text": " * exclusion must be enforced by the user)."
        },
        {
          "number": 1858,
          "text": " *"
        },
        {
          "number": 1859,
          "text": " * \\param ctrlr NVMe controller for which to allocate the I/O queue pair."
        },
        {
          "number": 1860,
          "text": " * \\param opts I/O qpair creation options, or NULL to use the defaults as returned"
        },
        {
          "number": 1861,
          "text": " * by spdk_nvme_ctrlr_get_default_io_qpair_opts()."
        }
      ]
