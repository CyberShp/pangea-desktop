        {
          "number": 2887,
          "text": "{"
        },
        {
          "number": 2888,
          "text": "\tstruct nvme_tcp_qpair *tqpair = nvme_tcp_qpair(qpair);"
        },
        {
          "number": 2889,
          "text": "\tint rc;"
        },
        {
          "number": 2890,
          "text": ""
        },
        {
          "number": 2891,
          "text": "\t/* If the qpair is still connecting, it'll be forced to authenticate later on */"
        },
        {
          "number": 2892,
          "text": "\tif (tqpair->state < NVME_TCP_QPAIR_STATE_RUNNING) {"
        },
        {
          "number": 2893,
          "text": "\t\treturn 0;"
        },
        {
          "number": 2894,
          "text": "\t} else if (tqpair->state != NVME_TCP_QPAIR_STATE_RUNNING) {"
        },
        {
          "number": 2895,
          "text": "\t\treturn -ENOTCONN;"
        },
        {
          "number": 2896,
          "text": "\t}"
        },
        {
          "number": 2897,
          "text": ""
        },
        {
          "number": 2898,
          "text": "\trc = nvme_fabric_qpair_authenticate_async(qpair);"
        },
        {
          "number": 2899,
          "text": "\tif (rc == 0) {"
        },
        {
          "number": 2900,
          "text": "\t\tnvme_tcp_qpair_set_state(tqpair, NVME_TCP_QPAIR_STATE_AUTHENTICATING);"
        },
        {
          "number": 2901,
          "text": "\t\tnvme_qpair_set_state(qpair, NVME_QPAIR_CONNECTING);"
