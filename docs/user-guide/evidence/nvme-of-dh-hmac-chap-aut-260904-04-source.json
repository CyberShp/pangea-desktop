      "lines": [
        {
          "number": 272,
          "text": "static int"
        },
        {
          "number": 273,
          "text": "nvme_auth_get_key(struct spdk_key *key, const char *nqn, void *buf, size_t buflen)"
        },
        {
          "number": 274,
          "text": "{"
        },
        {
          "number": 275,
          "text": "\tchar keystr[NVME_AUTH_CHAP_KEY_MAX_SIZE + 1] = {};"
        },
        {
          "number": 276,
          "text": "\tchar keyb64[NVME_AUTH_CHAP_KEY_MAX_SIZE] = {};"
        },
        {
          "number": 277,
          "text": "\tchar *tmp, *secret;"
        },
        {
          "number": 278,
          "text": "\tuint32_t hash;"
        },
        {
          "number": 279,
          "text": "\tint rc;"
        },
        {
          "number": 280,
          "text": "\tsize_t keylen;"
        },
        {
          "number": 281,
          "text": ""
        },
        {
          "number": 282,
          "text": "\trc = spdk_key_get_key(key, keystr, NVME_AUTH_CHAP_KEY_MAX_SIZE);"
        },
        {
          "number": 283,
          "text": "\tif (rc < 0) {"
        },
        {
          "number": 284,
          "text": "\t\tSPDK_ERRLOG(\"Failed to load key=%s: %s\\n\", spdk_key_get_name(key),"
        },
        {
          "number": 285,
          "text": "\t\t\t    spdk_strerror(-rc));"
        },
        {
          "number": 286,
          "text": "\t\tgoto out;"
        },
        {
          "number": 287,
          "text": "\t}"
        },
        {
          "number": 288,
          "text": ""
        },
        {
          "number": 289,
          "text": "\trc = sscanf(keystr, \"DHHC-1:%02x:\", &hash);"
        },
        {
          "number": 290,
          "text": "\tif (rc != 1) {"
        },
        {
          "number": 291,
          "text": "\t\tSPDK_ERRLOG(\"Invalid key format (key=%s)\\n\", spdk_key_get_name(key));"
        },
        {
          "number": 292,
          "text": "\t\trc = -EINVAL;"
        },
        {
          "number": 293,
          "text": "\t\tgoto out;"
        },
        {
          "number": 294,
          "text": ""
        },
        {
          "number": 295,
          "text": "\t}"
        },
        {
          "number": 296,
          "text": "\t/* Start at the first character after second \":\" and remove the trailing \":\" */"
        },
        {
          "number": 297,
          "text": "\tsecret = &keystr[10];"
        },
        {
          "number": 298,
          "text": "\ttmp = strstr(secret, \":\");"
        },
        {
          "number": 299,
          "text": "\tif (!tmp) {"
        },
        {
          "number": 300,
          "text": "\t\tSPDK_ERRLOG(\"Invalid key format (key=%s)\\n\", spdk_key_get_name(key));"
        },
        {
          "number": 301,
          "text": "\t\trc = -EINVAL;"
        },
        {
          "number": 302,
          "text": "\t\tgoto out;"
        },
        {
          "number": 303,
          "text": "\t}"
        },
        {
          "number": 304,
          "text": ""
        },
        {
          "number": 305,
          "text": "\t*tmp = '\\0';"
        },
        {
          "number": 306,
          "text": "\tkeylen = sizeof(keyb64);"
        },
        {
          "number": 307,
          "text": "\trc = spdk_base64_decode(keyb64, &keylen, secret);"
        },
        {
          "number": 308,
          "text": "\tif (rc != 0) {"
        },
        {
          "number": 309,
          "text": "\t\tSPDK_ERRLOG(\"Invalid key format (key=%s)\\n\", spdk_key_get_name(key));"
        },
        {
          "number": 310,
          "text": "\t\trc = -EINVAL;"
        },
        {
          "number": 311,
          "text": "\t\tgoto out;"
        },
        {
          "number": 312,
          "text": "\t}"
        },
        {
          "number": 313,
          "text": "\t/* Only 32B, 48B, and 64B keys are supported (+ 4B, as they're followed by a crc32) */"
        },
        {
          "number": 314,
          "text": "\tif (keylen != 36 && keylen != 52 && keylen != 68) {"
        },
        {
          "number": 315,
          "text": "\t\tSPDK_ERRLOG(\"Invalid key size=%zu (key=%s)\\n\", keylen, spdk_key_get_name(key));"
        },
        {
          "number": 316,
          "text": "\t\trc = -EINVAL;"
        },
        {
          "number": 317,
          "text": "\t\tgoto out;"
        },
        {
          "number": 318,
          "text": "\t}"
        },
        {
          "number": 319,
          "text": ""
        },
        {
          "number": 320,
          "text": "\tkeylen -= 4;"
        },
        {
          "number": 321,
          "text": "\tif (~spdk_crc32_ieee_update(keyb64, keylen, ~0) != from_le32(&keyb64[keylen])) {"
        },
        {
          "number": 322,
          "text": "\t\tSPDK_ERRLOG(\"Invalid key checksum (key=%s)\\n\", spdk_key_get_name(key));"
        },
        {
          "number": 323,
          "text": "\t\trc = -EINVAL;"
        },
        {
          "number": 324,
          "text": "\t\tgoto out;"
        },
        {
          "number": 325,
          "text": "\t}"
        },
        {
          "number": 326,
          "text": ""
        },
        {
          "number": 327,
          "text": "\trc = nvme_auth_transform_key(key, hash, nqn, keyb64, keylen, buf, buflen);"
        },
        {
          "number": 328,
          "text": "out:"
        },
        {
          "number": 329,
          "text": "\tspdk_memset_s(keystr, sizeof(keystr), 0, sizeof(keystr));"
        },
        {
          "number": 330,
          "text": "\tspdk_memset_s(keyb64, sizeof(keyb64), 0, sizeof(keyb64));"
        },
        {
          "number": 331,
          "text": ""
        },
        {
          "number": 332,
          "text": "\treturn rc;"
        },
        {
          "number": 333,
          "text": "}"
        }
      ]
