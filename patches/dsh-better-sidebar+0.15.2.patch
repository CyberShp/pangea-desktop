+/** Find one real, viewable workspace file for the path-less empty state. */
+async function findSuggestedFile(ctx: Context, scope: SessionScope, signal: AbortSignal): Promise<string | null> {
+  const root = scope.cwd
+  if (root === undefined || root === '') return null
+  const pending = [{ path: root, depth: 0 }]
+  const candidates: string[] = []
+  let inspected = 0
+
+  while (pending.length > 0 && inspected < 32) {
+    const current = pending.shift()!
+    inspected += 1
+    const listing = await api.fsTree(scope, current.path, signal)
+    const entries = listing.entries.filter(entry => !entry.hidden && !entry.broken && !entry.isSymlink)
+    for (const entry of entries) {
+      if (entry.isDir) continue
+      const viewer = ctx.betterSidebar?.matchFileViewer(entry.path)
+      if (viewer !== undefined && canShowPendingTextActions(entry.path, viewer.id)) candidates.push(entry.path)
+    }
+
+    if (current.depth >= 3) continue
+    const directories = entries.filter(entry => entry.isDir)
+      .sort((a, b) => {
+        const aSource = /^(src|source)$/i.test(a.name) ? 0 : 1
+        const bSource = /^(src|source)$/i.test(b.name) ? 0 : 1
+        return aSource - bSource || a.name.localeCompare(b.name, undefined, { sensitivity: 'base' })
+      })
+    for (const entry of directories) pending.push({ path: entry.path, depth: current.depth + 1 })
+  }
+
+  return candidates.sort((a, b) => {
+    const relativeA = relativeTo(root, a).replace(/\\/g, '/')
+    const relativeB = relativeTo(root, b).replace(/\\/g, '/')
+    const sourceA = /^(src|source)\//i.test(relativeA) ? 0 : 1
+    const sourceB = /^(src|source)\//i.test(relativeB) ? 0 : 1
+    const codeA = ctx.betterSidebar?.matchFileViewer(a)?.id === 'code' ? 0 : 1
+    const codeB = ctx.betterSidebar?.matchFileViewer(b)?.id === 'code' ? 0 : 1
+    return sourceA - sourceB || codeA - codeB || relativeA.localeCompare(relativeB, undefined, { sensitivity: 'base' })
+  })[0] ?? null
+}
