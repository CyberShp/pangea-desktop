+/** Whether the loaded text is a complete, dirty document that can be saved. */
+export function canSaveText({ contentLoaded, truncated, saving, dirty }) {
+  return contentLoaded === true && truncated !== true && saving !== true && dirty === true
+}
+
+/** Whether a pending read may show the disabled text-editor actions. */
+const TEXT_EXTENSIONS = new Set([
+  'js', 'mjs', 'cjs', 'jsx', 'ts', 'mts', 'cts', 'tsx', 'json', 'jsonc', 'md', 'markdown',
+  'py', 'pyw', 'html', 'htm', 'css', 'xml', 'xsl', 'yaml', 'yml', 'sql', 'java', 'cs',
+  'kt', 'kts', 'swift', 'c', 'h', 'cc', 'cpp', 'cxx', 'hpp', 'hh', 'hxx', 'rs', 'go',
+  'php', 'sh', 'bash', 'zsh', 'toml', 'nginx', 'conf', 'dockerfile', 'docker', 'properties', 'env',
+])
+
+export function canShowPendingTextActions(path, viewerId) {
+  if (viewerId === 'markdown' || viewerId === 'html') return true
+  if (viewerId !== 'code') return false
+  const dot = path.lastIndexOf('.')
+  const extension = dot < 0 ? '' : path.slice(dot + 1).toLowerCase()
+  return TEXT_EXTENSIONS.has(extension)
+}
+
+/**
+ * Label a Mermaid Markdown preview from the selected document and its first
+ * heading. This keeps the section eyebrow tied to user content instead of
+ * embedding a demo title in the viewer.
+ */
+export function markdownPreviewKicker(path, text) {
+  const filename = (path.split(/[\\/]/).pop() ?? 'document').replace(/\.[^.]+$/, '').toUpperCase()
+  const firstHeading = text.split(/\r?\n/).find((line) => /^ {0,3}#{1,6}\s+/.test(line)) ?? ''
+  const topic = /\b(?:sampling|sample\s+period)\b|采样(?:周期|时间|频率)/iu.test(firstHeading)
+    ? 'SAMPLING'
+    : 'MARKDOWN'
+  return `${filename} / ${topic}`
+}
