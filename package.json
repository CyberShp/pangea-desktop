{
  "name": "pangea-desktop",
  "version": "0.1.0",
  "description": "AI-first desktop test workbench for PANGEA analysis and test plugins.",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "CyberShp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyberShp/pangea-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/CyberShp/pangea-desktop/issues"
  },
  "homepage": "https://github.com/CyberShp/pangea-desktop#readme",
  "keywords": [
    "deepseek",
    "harness",
    "electron",
    "desktop",
    "agent"
  ],
  "scripts": {
    "postinstall": "patch-package && node scripts/install-pangea-model-settings-entry.mjs && node scripts/install-brand-assets.mjs && install-electron --no",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:dir": "node scripts/verify-pangea-staging.mjs && npm run build && electron-builder --dir --win --x64 --publish never",
    "package:dev:dir": "node scripts/verify-pangea-staging.mjs && npm run build && electron-builder --dir --win --x64 --publish never --config electron-builder.dev.cjs",
    "package:dev:win": "node scripts/verify-pangea-staging.mjs && node scripts/verify-target.mjs win32 x64 && npm run build && electron-builder --dir --win --x64 --publish never --config electron-builder.dev.cjs",
    "package:win": "node scripts/verify-pangea-staging.mjs && node scripts/verify-target.mjs win32 x64 && npm run build && electron-builder --dir --win --x64 --publish never",
    "package:pangea:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-pangea-desktop.ps1"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.1-rc.2",
    "@deepseek-ai/dsh-authorization": "0.1.1-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-telemetry": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.1.1-rc.2",
    "@deepseek-ai/dsh-spill": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-workflow": "0.1.1-rc.2",
    "dsh-better-sidebar": "0.15.2",
    "dsh-desktop-hmr-fallback": "file:packages/dsh-desktop-hmr-fallback",
    "dsh-desktop-market-installer": "file:packages/dsh-desktop-market-installer",
    "dsh-pangea-product": "file:packages/dsh-pangea-product",
    "node": "24.9.0",
    "pnpm": "10.34.5",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ssh2": "^1.17.0",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/unzipper": "^0.10.11",
    "archiver": "^8.0.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "patch-package": "^8.0.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10",
    "yaml": "^2.8.3"
  },
  "overrides": {
    "koffi": "3.1.5"
  },
  "build": {
    "appId": "io.pangea.desktop",
    "productName": "PANGEA Desktop",
    "asar": false,
    "npmRebuild": false,
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "zh_CN",
      "zh-TW",
      "zh_TW"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json",
      "!**/*.map",
      "!**/node_modules/@mistralai/mistralai/src/**"
    ],
    "extraResources": [
      {
        "from": "build/app-icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/harness-node-entry.mjs",
        "to": "harness-node-entry.mjs"
      },
      {
        "from": "build/dsh-desktop.patch.yml",
        "to": "dsh-desktop.patch.yml"
      },
      {
        "from": "build/splash.html",
        "to": "splash.html"
      },
      {
        "from": "build/splash-logo-light.png",
        "to": "splash-logo-light.png"
      },
      {
        "from": "build/splash-logo-dark.png",
        "to": "splash-logo-dark.png"
      },
      {
        "from": "build/dsh-loader.gif",
        "to": "dsh-loader.gif"
      },
      {
        "from": "build/dsh-loader-dark.gif",
        "to": "dsh-loader-dark.gif"
      },
      {
        "from": "build/plugin-recovery.html",
        "to": "plugin-recovery.html"
      },
      {
        "from": "build/safe-mode.html",
        "to": "safe-mode.html"
      },
      {
        "from": "build/windows-menu.html",
        "to": "windows-menu.html"
      },
      {
        "from": ".pangea-build/plugins/dsh-pangea",
        "to": "app/node_modules/dsh-pangea"
      },
      {
        "from": ".pangea-build/plugins/dsh-pangea-companion",
        "to": "app/node_modules/dsh-pangea-companion"
      },
      {
        "from": ".pangea-build/plugins/dsh-pangea-asset-catalog",
        "to": "app/node_modules/dsh-pangea-asset-catalog"
      },
      {
        "from": ".pangea-build/plugins/dsh-pangea-run-ui",
        "to": "app/node_modules/dsh-pangea-run-ui"
      },
      {
        "from": ".pangea-build/runtime/pangea-runtime",
        "to": "pangea-runtime"
      },
      {
        "from": ".pangea-build/runtime/python",
        "to": "pangea-python"
      },
      {
        "from": ".pangea-build/manifest.json",
        "to": "pangea-manifest.json"
      },
      {
        "from": ".pangea-build/update",
        "to": "update"
      },
      {
        "from": "build/apply-portable-update.ps1",
        "to": "update/apply-portable-update.ps1"
      }
    ],
    "publish": null,
    "artifactName": "pangea-desktop-${version}-windows-${arch}-portable.${ext}",
    "win": {
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": false
    }
  }
}
