{
  "name": "dsh-pangea-product",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "dsh-better-sidebar": "0.15.2",
    "dsh-pangea": "0.1.0",
    "dsh-pangea-companion": "0.10.0",
    "dsh-pangea-asset-catalog": "0.1.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": { "optional": true },
    "dsh-pangea": { "optional": true },
    "dsh-pangea-companion": { "optional": true },
    "dsh-pangea-asset-catalog": { "optional": true }
  }
}
